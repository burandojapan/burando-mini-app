# NEW staging resources only. Never copy the production .env.
APP_ENV=staging
# Set false only after isolated DB + storage + test bot are configured.
STAGING_SETUP_MODE=true
DEV_MODE=false
NOTIFICATIONS_ENABLED=false
STAGING_ISOLATION_CONFIRMED=false
STAGING_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
# Legacy server-key alternative:
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY=
STAGING_SITE_USER=burando-test
STAGING_SITE_PASSWORD=
BOT_TOKEN=
# No real customer/admin chat IDs in staging.
ADMIN_CHAT_ID=

# Preview only; no product publication or daily sync.
SMART_IMPORT_PREVIEW_ENABLED=false
